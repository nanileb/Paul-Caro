{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Un Worker + une base D1 par mariage. Déploiement : npx wrangler deploy --env <slug>
  // Sans --env (dev local) : le site de Pauline & Benjamin.
  "name": "mariage-pauline-benjamin",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "WEDDING_SLUG": "pauline-benjamin" },
  "d1_databases": [{ "binding": "DB", "database_name": "mariage-local", "database_id": "local", "migrations_dir": "migrations" }],
  "env": {
    // Pauline & Benjamin
    "pauline-benjamin": {
      "name": "mariage-pauline-benjamin",
      "vars": { "WEDDING_SLUG": "pauline-benjamin" },
      "d1_databases": [{ "binding": "DB", "database_name": "mariage-pauline-benjamin", "database_id": "A_REMPLIR", "migrations_dir": "migrations" }]
      // Domaine payant plus tard : "routes": [{ "pattern": "exemple.fr", "custom_domain": true }]
    },
    // Paul & Caroline - Wedding
    "paul-caroline-wedding": {
      "name": "paul-caroline-wedding",
      "vars": { "WEDDING_SLUG": "paul-caroline-wedding" },
      "d1_databases": [{ "binding": "DB", "database_name": "paul-caroline-wedding", "database_id": "06b222b9-b997-46ea-b77b-58902e01fad4", "migrations_dir": "migrations" }],
      "assets": { "directory": "./public/paul-caroline-wedding" },
      // Domaine définitif (www redirigé vers pauletcaroline.com par le Worker)
      "routes": [
        { "pattern": "pauletcaroline.com", "zone_name": "pauletcaroline.com", "custom_domain": true },
        { "pattern": "www.pauletcaroline.com", "zone_name": "pauletcaroline.com", "custom_domain": true }
      ]
    },
    // Ethan & Julia
    "ethan-julia": {
      "name": "mariage-ethan-julia",
      "vars": { "WEDDING_SLUG": "ethan-julia" },
      "d1_databases": [{ "binding": "DB", "database_name": "mariage-ethan-julia", "database_id": "A_REMPLIR", "migrations_dir": "migrations" }]
      // Domaine payant plus tard : "routes": [{ "pattern": "exemple.fr", "custom_domain": true }]
    },
    // Marie & Paul
    "marie-paul": {
      "name": "mariage-marie-paul",
      "vars": { "WEDDING_SLUG": "marie-paul" },
      "d1_databases": [{ "binding": "DB", "database_name": "mariage-marie-paul", "database_id": "A_REMPLIR", "migrations_dir": "migrations" }]
      // Domaine payant plus tard : "routes": [{ "pattern": "exemple.fr", "custom_domain": true }]
    },
    // Emma & Gab
    "emma-gab": {
      "name": "mariage-emma-gab",
      "vars": { "WEDDING_SLUG": "emma-gab" },
      "d1_databases": [{ "binding": "DB", "database_name": "mariage-emma-gab", "database_id": "A_REMPLIR", "migrations_dir": "migrations" }]
      // Domaine payant plus tard : "routes": [{ "pattern": "exemple.fr", "custom_domain": true }]
    }
  }
}
